# ============================================================
# User settings
# ============================================================
KEGG_ORGANISM <- "dme"
QVALUE_THRESHOLD <- 0.05
# Set to NULL if you do not want an FC threshold
LOG2FC_THRESHOLD <- NULL
# Minimum number of significant metabolites required
# to make a pathway heatmap
MIN_METABOLITES_PER_PATHWAY <- 2
# Whether samples should be clustered WITHIN each genotype
CLUSTER_SAMPLES <- FALSE
# Optionally exclude very broad KEGG maps
EXCLUDE_KEGG_PATHWAYS <- c(
"01100"  # Metabolic pathways
)
# Heatmap colors
HEATMAP_COLORS <- rev(RColorBrewer::brewer.pal(5, "RdYlBu"))
HEATMAP_BREAKS = c(
-2, -1, 0, 1, 2
)
# Adjust names/levels to your actual GENOTYPE2 values
GENOTYPE_COLORS <- c(
WT_LIP = "purple",
MUT_LIP = "darkgreen"
)
