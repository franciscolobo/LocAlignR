df_plot <- df_plot %>%
mutate(
TLX3_class = ifelse(TLX3 > 3, "TLX3 > 0", "TLX3 <= 0")
)
table(df_plot$TLX3_class)
# Compute medians for annotation
median_df <- df_plot %>%
group_by(TLX3_class) %>%
summarise(
median_IKZF2 = median(IKZF2, na.rm = TRUE)
)
# Plot
ggplot(df_plot, aes(x = TLX3_class, y = IKZF2, fill = TLX3_class)) +
# violin plot
geom_violin(trim = FALSE, alpha = 0.5) +
# jittered points
geom_jitter(width = 0.15, size = 1.5, alpha = 0.7) +
# median point
stat_summary(
fun = median,
geom = "point",
shape = 23,
size = 4,
fill = "red",
color = "black"
) +
# median value text
geom_text(
data = median_df,
aes(
x = TLX3_class,
y = median_IKZF2,
label = round(median_IKZF2, 2)
),
vjust = -1,
fontface = "bold"
) +
stat_compare_means(
method = "wilcox.test",
label = "p.format"
) +
labs(
x = "TLX3 class",
y = "IKXF2 z-score",
title = "IKZF2 expression grouped by TLX3 z-score"
) +
theme_classic() +
theme(
legend.position = "none"
)
