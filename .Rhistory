if (!is.null(normalized_counts)) {
normalized_counts <- normalized_counts[, rownames(metadata), drop = FALSE]
}
gene_id <- NULL
if (!is.null(gene_metadata)) {
if (gene %in% rownames(gene_metadata)) {
gene_id <- gene
} else if (gene_name_col %in% colnames(gene_metadata)) {
idx <- which(gene_metadata[[gene_name_col]] == gene)
if (length(idx) > 0) gene_id <- rownames(gene_metadata)[idx[1]]
}
}
if (is.null(gene_id)) {
if (gene %in% rownames(counts)) {
gene_id <- gene
} else {
stop("Gene not found.")
}
}
raw_df <- data.frame(
Sample = colnames(counts),
Expression = as.numeric(counts[gene_id, ]),
ExpressionType = "Raw counts"
)
plot_df <- raw_df
if (!is.null(normalized_counts)) {
norm_df <- data.frame(
Sample = colnames(normalized_counts),
Expression = as.numeric(normalized_counts[gene_id, ]),
ExpressionType = "DESeq2-normalized counts"
)
plot_df <- bind_rows(plot_df, norm_df)
}
metadata$Sample <- rownames(metadata)
plot_df <- left_join(plot_df, metadata, by = "Sample")
plot_df[[group_col]] <- dplyr::recode(
plot_df[[group_col]],
"WT" = "Gli3 KO",
"KO" = "Shh/Gli3 DKO"
)
if (log10_transform) {
plot_df$Expression <- log10(plot_df$Expression + 1)
ylab <- "log10(count + 1)"
} else {
ylab <- "Count"
}
p <- ggplot(
plot_df,
aes(
x = .data[[group_col]],
y = Expression,
color = .data[[group_col]]
)
)
if (boxplot) {
p <- p +
geom_boxplot(
outlier.shape = NA,
alpha = 0.2,
width = 0.5
)
}
if (!is.null(pair_col) && paired_lines) {
p <- p +
geom_line(
aes(
group = interaction(
.data[["ExpressionType"]],
.data[[pair_col]]
)
),
color = "grey50",
alpha = 0.7,
linewidth = 0.5
)
}
p <- p +
geom_point(size = point_size) +
facet_wrap(~ ExpressionType, scales = "free_y") +
scale_color_manual(
values = c(
"Gli3 KO" = "darkblue",
"Shh/Gli3 DKO" = "orange"
)
) +
labs(
title = gene,
subtitle = gene_id,
x = NULL,
y = ylab,
color = NULL
) +
theme_classic() +
theme(
strip.background = element_blank(),
strip.text = element_text(face = "bold")
)
return(list(
gene_id = gene_id,
plot_data = plot_df,
plot = p
))
}
run_stage_de <- function(
stage_name,
counts,
meta,
gene_metadata = NULL,
method = c("voom", "qlf"),
outdir = "DE_results"
) {
library(edgeR)
library(limma)
library(Glimma)
method <- match.arg(method)
dir.create(outdir, showWarnings = FALSE, recursive = TRUE)
meta_stage <- droplevels(meta[meta$Stage == stage_name, ])
counts_stage <- counts[, rownames(meta_stage), drop = FALSE]
stopifnot(nrow(meta_stage) > 0)
stopifnot(ncol(counts_stage) > 0)
stopifnot(all(colnames(counts_stage) == rownames(meta_stage)))
meta_stage$Genotype_Shh <- relevel(
factor(meta_stage$Genotype_Shh),
ref = "WT"
)
design <- model.matrix(~ Genotype_Shh, data = meta_stage)
coef_name <- "Genotype_ShhKO"
y <- DGEList(counts = counts_stage)
y <- calcNormFactors(y)
keep <- filterByExpr(y, design = design)
y <- y[keep, , keep.lib.sizes = FALSE]
y <- calcNormFactors(y)
counts_stage_filt <- counts_stage[rownames(y), , drop = FALSE]
anno_full <- data.frame(
gene_id = rownames(y),
row.names = rownames(y)
)
if (!is.null(gene_metadata)) {
gene_cols <- intersect(
c("gene_name", "gene_chr", "gene_length", "gene_biotype"),
colnames(gene_metadata)
)
gene_anno <- gene_metadata[rownames(y), gene_cols, drop = FALSE]
anno_full <- cbind(anno_full, gene_anno)
}
raw_counts <- as.data.frame(counts_stage_filt)
colnames(raw_counts) <- paste0("raw_count_", colnames(raw_counts))
anno_full <- cbind(anno_full, raw_counts)
stopifnot(nrow(anno_full) == nrow(y))
stopifnot(all(rownames(anno_full) == rownames(y)))
sample_metadata_for_output <- meta_stage[, intersect(
c("Sample", "Stage", "Litter", "Sex", "Genotype_Shh"),
colnames(meta_stage)
), drop = FALSE]
glimmaMDS(
y,
groups = meta_stage$Genotype_Shh,
folder = file.path(outdir, paste0("Glimma_MDS_", stage_name, "_", method))
)
if (method == "voom") {
v <- voom(y, design, plot = TRUE)
fit <- lmFit(v, design)
fit <- eBayes(fit)
tt <- topTable(
fit,
coef = coef_name,
number = Inf,
sort.by = "P"
)
tt$gene_id <- rownames(tt)
glMDPlot(
fit,
coef = coef_name,
counts = v$E,
groups = meta_stage$Genotype_Shh,
status = decideTests(fit)[, coef_name],
anno = anno_full,
folder = file.path(outdir, paste0("Glimma_MD_", stage_name, "_KO_vs_WT_voom"))
)
result <- list(
stage = stage_name,
method = method,
metadata = meta_stage,
sample_metadata_for_output = sample_metadata_for_output,
design = design,
y = y,
voom = v,
fit = fit,
top_table = tt,
anno = anno_full
)
}
if (method == "qlf") {
y <- estimateDisp(y, design)
fit <- glmQLFit(y, design)
qlf <- glmQLFTest(
fit,
coef = coef_name
)
tt <- topTags(
qlf,
n = Inf
)$table
tt$gene_id <- rownames(tt)
glimmaMA(
qlf,
dge = y,
groups = meta_stage$Genotype_Shh,
anno = anno_full,
folder = file.path(outdir, paste0("Glimma_MA_", stage_name, "_KO_vs_WT_qlf"))
)
result <- list(
stage = stage_name,
method = method,
metadata = meta_stage,
sample_metadata_for_output = sample_metadata_for_output,
design = design,
y = y,
fit = fit,
qlf = qlf,
top_table = tt,
anno = anno_full
)
}
write.csv(
tt,
file = file.path(outdir, paste0(method, "_", stage_name, "_KO_vs_WT.csv")),
row.names = FALSE
)
return(result)
}
run_stage_limma <- function(stage_name, counts, meta, outdir = "DE_results") {
library(edgeR)
library(limma)
library(Glimma)
dir.create(outdir, showWarnings = FALSE, recursive = TRUE)
meta_stage <- droplevels(meta[meta$Stage == stage_name, ])
counts_stage <- counts[, rownames(meta_stage), drop = FALSE]
stopifnot(nrow(meta_stage) > 0)
stopifnot(ncol(counts_stage) > 0)
stopifnot(all(colnames(counts_stage) == rownames(meta_stage)))
meta_stage$Litter <- factor(meta_stage$Litter)
meta_stage$Genotype_Shh <- relevel(factor(meta_stage$Genotype_Shh), ref = "WT")
y <- DGEList(counts = counts_stage)
y <- calcNormFactors(y)
design <- model.matrix(~ Litter + Sex + Genotype_Shh, data = meta_stage)
#  design <- model.matrix(~ Genotype_Shh, data = meta_stage)
print(colnames(design))
#  keep <- filterByExpr(y, design = design)
keep <- rowSums(cpm(y) > 1) >= 2
y <- y[keep, , keep.lib.sizes = FALSE]
y <- calcNormFactors(y)
# MDS plot
glimmaMDS(
y,
groups = meta_stage$Genotype_Shh,
folder = file.path(outdir, paste0("Glimma_MDS_", stage_name))
)
# limma-voom
v <- voom(y, design, plot = TRUE)
fit <- lmFit(v, design)
fit <- eBayes(fit)
coef_name <- "Genotype_ShhKO"
if (!coef_name %in% colnames(fit$coefficients)) {
stop(
"Coefficient not found: ", coef_name, "\n",
"Available coefficients:\n",
paste(colnames(fit$coefficients), collapse = "\n")
)
}
tt <- topTable(
fit,
coef = coef_name,
number = Inf,
sort.by = "P"
)
tt$gene_id <- rownames(tt)
write.csv(
tt,
file = file.path(outdir, paste0("limma_voom_", stage_name, "_KO_vs_WT.csv")),
row.names = FALSE
)
anno = gene_metadata
gene_anno <- gene_metadata[rownames(v$E), c(
"gene_name", "gene_chr", "gene_length", "gene_biotype"
), drop = FALSE]
stopifnot(nrow(gene_anno) == nrow(v$E))
stopifnot(all(rownames(gene_anno) == rownames(v$E)))
raw_counts_stage <- count_df[rownames(v$E), , drop = FALSE]
raw_counts_stage <- as.data.frame(raw_counts_stage)
colnames(raw_counts_stage) <- paste0("raw_count_", colnames(raw_counts_stage))
anno_full <- cbind(gene_anno, raw_counts_stage)
stopifnot(nrow(anno_full) == nrow(v$E))
stopifnot(all(rownames(anno_full) == rownames(v$E)))
# Glimma MD plot
glMDPlot(
fit,
coef = coef_name,
counts = v$E,
groups = meta_stage$Genotype_Shh,
status = decideTests(fit)[, coef_name],
folder = file.path(outdir, paste0("Glimma_MD_", stage_name, "_KO_vs_WT")),
anno = gene_anno
#    anno = anno_full
)
return(list(
stage = stage_name,
metadata = meta_stage,
design = design,
y = y,
voom = v,
fit = fit,
top_table = tt
))
}
run_stage_deseq2 <- function(
stage_name,
counts,
meta,
gene_metadata = NULL,
outdir = "DE_results",
alpha = 0.05,
shrink_lfc = FALSE,
design = "Shh",
file_name = ""
) {
library(DESeq2)
library(Glimma)
dir.create(outdir, showWarnings = FALSE, recursive = TRUE)
meta_stage <- droplevels(meta[meta$Stage == stage_name, ])
counts_stage <- counts[, rownames(meta_stage), drop = FALSE]
stopifnot(nrow(meta_stage) > 0)
stopifnot(ncol(counts_stage) > 0)
stopifnot(all(colnames(counts_stage) == rownames(meta_stage)))
meta_stage$Genotype_Shh <- relevel(
factor(meta_stage$Genotype_Shh),
ref = "WT"
)
counts_stage <- round(as.matrix(counts_stage))
dds <- DESeqDataSetFromMatrix(
countData = counts_stage,
colData = meta_stage,
if (design == "Shh") {
design = ~ Genotype_Shh
} else if (design == "Litter_Shh") {
design = ~ Litter + Genotype_Shh
} else if (design == "Sex_Shh") {
design = ~ Sex + Genotype_Shh
} else {
stop(print(paste0("Design not found: ", design, ".")))
}
)
keep <- rowSums(counts(dds)) > 0
dds <- dds[keep, ]
dds <- DESeq(dds)
res <- results(
dds,
contrast = c("Genotype_Shh", "KO", "WT"),
alpha = alpha
)
if (shrink_lfc) {
coef_name <- "Genotype_Shh_KO_vs_WT"
if (coef_name %in% resultsNames(dds)) {
res <- lfcShrink(
dds,
coef = coef_name,
type = "apeglm"
)
} else {
warning(
"Could not find coefficient for LFC shrinkage. Available coefficients:\n",
paste(resultsNames(dds), collapse = "\n")
)
}
}
tt <- as.data.frame(res)
tt$gene_id <- rownames(tt)
anno_full <- data.frame(
gene_id = rownames(dds),
row.names = rownames(dds)
)
if (!is.null(gene_metadata)) {
gene_cols <- intersect(
c("gene_name", "gene_chr", "gene_length", "gene_biotype"),
colnames(gene_metadata)
)
gene_anno <- gene_metadata[rownames(dds), gene_cols, drop = FALSE]
anno_full <- cbind(anno_full, gene_anno)
}
raw_counts <- as.data.frame(counts_stage[rownames(dds), , drop = FALSE])
colnames(raw_counts) <- paste0("raw_count_", colnames(raw_counts))
anno_full <- cbind(anno_full, raw_counts)
tt <- merge(
tt,
anno_full,
by.x = "gene_id",
by.y = "gene_id",
all.x = TRUE,
sort = FALSE
)
tt <- tt[order(tt$pvalue), ]
write.csv(
tt,
file = file.path(outdir, paste0("deseq2_", stage_name, "_", file_name, "_Gli3_Shh_DKO_vs_Gli3_KO.csv")),
row.names = FALSE
)
normalized_counts <- counts(dds, normalized = TRUE)
write.csv(
normalized_counts,
file = file.path(outdir, paste0("deseq2_", stage_name, "_normalized_counts.csv"))
)
vsd <- vst(dds, blind = FALSE)
glimmaMDS(
assay(vsd),
groups = meta_stage$Genotype_Shh,
folder = file.path(outdir, paste0("Glimma_MDS_", stage_name, "_", file_name,  "_deseq2"))
)
result <- list(
stage = stage_name,
method = "deseq2",
metadata = meta_stage,
dds = dds,
results = res,
top_table = tt,
normalized_counts = normalized_counts,
vst = vsd,
anno = anno_full
)
return(result)
}
