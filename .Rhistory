pathway_names,
by = "pathway_id"
) %>%
distinct(
gene_name,
pathway_id,
pathway_name,
.keep_all = TRUE
)
de_kegg %>%
count(pathway_name, sort = TRUE)
min_genes <- 3
genes_by_pathway <- de_kegg %>%
group_by(pathway_name) %>%
summarise(
genes = list(unique(gene_ID)),
.groups = "drop"
) %>%
filter(lengths(genes) >= min_genes) %>%
deframe()
length(genes_by_pathway)
head(names(genes_by_pathway))
sample_info$condition <- factor(
sample_info$Genotype,
levels = c("WT", "Mutant")
)
sample_info <- sample_info %>%
arrange(condition)
expr <- expr[, sample_info$SampleID, drop = FALSE]
stopifnot(
identical(colnames(expr), sample_info$SampleID)
)
# 7. Function for a KEGG pathway heatmap
plot_kegg_heatmap <- function(
pathway,
genes_by_pathway,
expr,
sample_info,
min_genes = 3,
gene_labels = NULL,
heatmap_colors = c("blue", "white", "red"),
heatmap_breaks = c(-2, 0, 2),
condition_colors = NULL,
cluster_samples = FALSE,
show_values = TRUE,
value_digits = 1,
value_fontsize = 7
) {
# ----------------------------------------------------------
# Genes
# ----------------------------------------------------------
genes <- genes_by_pathway[[pathway]]
if (is.null(genes)) {
stop("Pathway not found: ", pathway)
}
genes <- intersect(genes, rownames(expr))
if (length(genes) < min_genes) {
stop(
"Only ", length(genes),
" genes from this pathway are present in the expression matrix."
)
}
# ----------------------------------------------------------
# Samples
# ----------------------------------------------------------
sample_info$sample <- as.character(sample_info$sample)
samples <- intersect(
sample_info$sample,
colnames(expr)
)
if (length(samples) == 0) {
stop("No samples in sample_info were found in expr.")
}
# ----------------------------------------------------------
# Raw expression matrix
# ----------------------------------------------------------
mat <- expr[
genes,
samples,
drop = FALSE
]
# Remove zero-variance genes
keep <- apply(
mat,
1,
sd,
na.rm = TRUE
) > 0
mat <- mat[
keep,
,
drop = FALSE
]
if (nrow(mat) < min_genes) {
stop(
"Only ", nrow(mat),
" genes remain after removing zero-variance genes."
)
}
# ----------------------------------------------------------
# Z-score matrix used for colors/clustering
# ----------------------------------------------------------
mat_z <- t(scale(t(mat)))
# ----------------------------------------------------------
# Match metadata to matrix columns
# ----------------------------------------------------------
sample_info_plot <- sample_info[
match(colnames(mat_z), sample_info$sample),
,
drop = FALSE
]
if (anyNA(sample_info_plot$sample)) {
stop(
"Some columns in the expression matrix could not be matched to sample_info."
)
}
condition <- factor(sample_info_plot$condition)
# ----------------------------------------------------------
# Gene labels
# ----------------------------------------------------------
if (is.null(gene_labels)) {
row_labels <- rownames(mat_z)
} else {
row_labels <- gene_labels[rownames(mat_z)]
missing_labels <- is.na(row_labels) | row_labels == ""
row_labels[missing_labels] <-
rownames(mat_z)[missing_labels]
}
# ----------------------------------------------------------
# Heatmap colors
# ----------------------------------------------------------
if (length(heatmap_colors) != length(heatmap_breaks)) {
stop(
"heatmap_colors and heatmap_breaks must have the same length."
)
}
heatmap_col_fun <- circlize::colorRamp2(
heatmap_breaks,
heatmap_colors
)
# ----------------------------------------------------------
# Condition colors
# ----------------------------------------------------------
if (is.null(condition_colors)) {
condition_colors <- setNames(
grDevices::hcl.colors(
nlevels(condition),
palette = "Dark 3"
),
levels(condition)
)
}
# ----------------------------------------------------------
# Top annotation
# ----------------------------------------------------------
sample_annotation <- ComplexHeatmap::HeatmapAnnotation(
Condition = condition,
col = list(
Condition = condition_colors
),
simple_anno_size = grid::unit(4, "mm"),
show_legend = TRUE,
show_annotation_name = FALSE
)
# ----------------------------------------------------------
# Heatmap
# ----------------------------------------------------------
ComplexHeatmap::Heatmap(
mat_z,
name = "Z-score",
col = heatmap_col_fun,
cluster_rows = TRUE,
cluster_columns = cluster_samples,
column_split = condition,
cluster_column_slices = FALSE,
top_annotation = sample_annotation,
row_labels = row_labels,
show_row_names = TRUE,
show_column_names = TRUE,
row_names_gp = grid::gpar(fontsize = 8),
column_names_gp = grid::gpar(fontsize = 9),
column_title = NULL,
column_names_rot = 45,
# --------------------------------------------------------
# Print original expression values inside cells
# --------------------------------------------------------
cell_fun = if (show_values) {
function(j, i, x, y, width, height, fill) {
grid::grid.text(
sprintf(
paste0("%.", value_digits, "f"),
mat[i, j]
),
x,
y,
gp = grid::gpar(
fontsize = value_fontsize
)
)
}
} else {
NULL
},
use_raster = FALSE
)
}
condition_colors <- c(
WT = "purple",
Mutant  = "darkgreen"
)
#library(viridis)
heatmap_colors <- rev(RColorBrewer::brewer.pal(5, "RdYlBu"))
#colors
# heatmap_colors = c(
#   "navy",
#   "royalblue",
#   "yellow",
#   "orange",
#   "darkred"
# )
# heatmap_colors = c(
#   "navy",
#   "royalblue",
#   "yellow",
#   "orange",
#   "darkred"
# )
heatmap_breaks = c(
-2, -1, 0, 1, 2
)
gene_labels <- setNames(
paste0(gene_annot$gene_symbol, " - ", gene_annot$primary_FBgn),
gene_annot$primary_FBgn
)
for (pathway_id in kegg_to_plot$pathway_ID) {
description <- kegg_to_plot$description[kegg_to_plot$pathway_ID == pathway_id]
description_sanitized <- gsub(" ", "_", description)
description_sanitized <- gsub("[^A-Za-z0-9_]", "", description_sanitized)
description_sanitized <- gsub("_+", "_", description_sanitized)
print(description_sanitized)
number_of_genes <- length(unlist(unname(genes_by_pathway[description])))
if (number_of_genes < 1) {
print(paste0("Pathway ", description, " not processed: too few genes"))
next
} else {
ht <- plot_kegg_heatmap(
pathway = description,
genes_by_pathway = genes_by_pathway,
expr = expr,
sample_info = sample_info,
gene_labels = gene_labels,
condition_colors = condition_colors,
heatmap_colors = heatmap_colors,
heatmap_breaks = heatmap_breaks,
show_values = FALSE
#  value_digits = 3
)
pdf_height <- 1 + number_of_genes * 0.25
pdf(
file.path(
paste0(description_sanitized, ".pdf")
),
width = 8,
height = pdf_height
)
ComplexHeatmap::draw(ht)
dev.off()
}
}
