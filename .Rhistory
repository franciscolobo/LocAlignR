#   MUT_2    Mutant
sample_info <- read.table("data/metadata/transcriptomics/metadata_RNA_Seq.txt", header = TRUE, sep = "\t")
#subsetting to get only WT and Mutant for body ad libitum
sample_info <- sample_info[sample_info$Genotype %in% c("WT", "Mutant"),]
sample_info <- sample_info[sample_info$Organ %in% c("Body"),]
sample_info <- sample_info[sample_info$Feeding %in% c("Ad_libitum"),]
sample_info$sample <- sample_info$SampleID
# 1. Select the DE genes
# Modify the thresholds as appropriate.
de_sig <- de %>%
filter(
!is.na(adj.P.Val),
adj.P.Val < 0.2,
abs(logFC) >= 0
)
# 2. Convert gene symbols to Entrez IDs
# KEGG genes are represented using Entrez IDs.
symbol_to_entrez <- AnnotationDbi::select(
org.Dm.eg.db,
