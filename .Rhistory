library(cranlogs)
library(dplyr)
library(lubridate)
# Fetch data (e.g., from January 2024 to present)
future_downloads <- cran_downloads(
packages = "future",
from = "2024-01-01",
to = Sys.Date()
)
# Aggregate daily data into monthly totals
monthly_stats <- future_downloads %>%
mutate(month = floor_date(date, "month")) %>%
group_by(month) %>%
summarise(monthly_downloads = sum(count))
print(monthly_stats)
library(tidyverse)
xlsx_path <- "/Users/pereiralobof2/Projects/Francisco/data/CDBL_project_report_2025.xlsx"
sh <- "total"
df <- readxl::read_xlsx(path = xlsx_path, sheet = sh) |>
as.data.frame()
df_long <- df %>%
pivot_longer(
cols = -PI,            # all columns except 'entity'
names_to = "variable",     # variable name
values_to = "value"        # quantitative value
) %>%
mutate(
# control order of variables around the circle if desired
variable = factor(variable, levels = unique(variable)),
# text label combining entity and value (rounded to 2 decimals)
label_text = paste0(PI, " (", round(value, 2), ")")
)
# Order variables in the circle
df_long$variable <- factor(df_long$variable, levels = unique(df_long$variable))
ggplot(df_long, aes(x = PI, y = value, fill = PI)) +
# Bars: one per entity
geom_col() +
# Text labels: show numeric value above each bar, rotated 90°
geom_text(
aes(label = value),
vjust = -0.2,              # slightly above the bar
hjust = -0.1,              # slightly above the bar
angle = 90,                # rotate text
size = 3
) +
# One panel per variable, with independent Y axis
facet_wrap(~ variable, scales = "free_y") +
# Optional: control axis expansion so bars + labels fit
scale_y_continuous(expand = expansion(mult = c(0, 0.1))) +
theme_minimal() +
theme(
axis.title = element_blank(),
panel.grid.major.x = element_blank(),
legend.position = "none"   # keep or remove, depending on how many entities
)
small_cutoff <- 0.05
df_rel <- df_long %>%
group_by(variable) %>%
mutate(
total   = sum(value, na.rm = TRUE),
prop    = value / total,
label   = sprintf("%.1f%%", prop * 100),
# threshold for inside vs outside placement
# for example: segments < 5% are considered too small
small   = prop < small_cutoff
) %>%
ungroup()
ggplot(df_rel, aes(x = variable, y = prop, fill = PI)) +
# Stacked bars: sum(prop) = 1 per variable
geom_col() +
# Labels inside each sub-bar: show the relative frequency
geom_text(
aes(label = label),
position = position_stack(vjust = 0.5),
#    position = position_stack(vjust = 0.5),  # center vertically in each stack
color    = "white",
size     = 4,
#   min.segment.length = Inf
) +
# Y axis as percentages (0–100 %)
scale_y_continuous(labels = scales::percent_format(accuracy = 1)) +
theme_minimal() +
theme(
axis.title.x = element_blank(),
axis.title.y = element_blank()
) +
labs(fill = "PI")
