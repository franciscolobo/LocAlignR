plot_gene_expression <- function(
gene,
counts,
metadata,
normalized_counts = NULL,
gene_metadata = NULL,
stage = NULL,
pair_col = NULL,
gene_name_col = "gene_name",
group_col = "Genotype_Shh",
stage_col = "Stage",
log10_transform = TRUE,
point_size = 3,
boxplot = TRUE,
paired_lines = TRUE
) {
library(ggplot2)
library(dplyr)
if (!is.null(stage)) {
metadata <- metadata[metadata[[stage_col]] == stage, , drop = FALSE]
}
counts <- counts[, rownames(metadata), drop = FALSE]
if (!is.null(normalized_counts)) {
normalized_counts <- normalized_counts[, rownames(metadata), drop = FALSE]
}
gene_id <- NULL
if (!is.null(gene_metadata)) {
if (gene %in% rownames(gene_metadata)) {
gene_id <- gene
} else if (gene_name_col %in% colnames(gene_metadata)) {
idx <- which(gene_metadata[[gene_name_col]] == gene)
if (length(idx) > 0) {
gene_id <- rownames(gene_metadata)[idx[1]]
}
}
}
if (is.null(gene_id)) {
if (gene %in% rownames(counts)) {
gene_id <- gene
} else {
stop("Gene not found.")
}
}
raw_df <- data.frame(
Sample = colnames(counts),
Expression = as.numeric(counts[gene_id, ]),
ExpressionType = "Raw counts"
)
plot_df <- raw_df
if (!is.null(normalized_counts)) {
norm_df <- data.frame(
Sample = colnames(normalized_counts),
Expression = as.numeric(normalized_counts[gene_id, ]),
ExpressionType = "DESeq2-normalized counts"
)
plot_df <- bind_rows(plot_df, norm_df)
}
metadata$Sample <- rownames(metadata)
plot_df <- left_join(
plot_df,
metadata,
by = "Sample"
)
plot_df[[group_col]] <- dplyr::recode(
plot_df[[group_col]],
"WT" = "Gli3 KO",
"KO" = "Shh/Gli3 DKO"
)
if (log10_transform) {
plot_df$Expression <- log10(plot_df$Expression + 1)
ylab <- "log10(count + 1)"
} else {
ylab <- "Count"
}
pos <- position_dodge(width = 0.25)
p <- ggplot(
plot_df,
aes(
x = .data[[group_col]],
y = Expression,
color = .data[[group_col]]
)
)
if (boxplot) {
p <- p +
geom_boxplot(
outlier.shape = NA,
alpha = 0.2,
width = 0.5
)
}
if (!is.null(pair_col) && paired_lines) {
p <- p +
geom_line(
aes(
group = interaction(
.data[["ExpressionType"]],
.data[[pair_col]]
)
),
position = pos,
color = "grey50",
alpha = 0.7,
linewidth = 0.5
)
}
p <- p +
geom_point(
position = pos,
size = point_size
) +
facet_wrap(
~ ExpressionType,
scales = "free_y"
) +
scale_color_manual(
values = c(
"Gli3 KO" = "darkblue",
"Shh/Gli3 DKO" = "orange"
)
) +
labs(
title = gene,
subtitle = gene_id,
x = NULL,
y = ylab,
color = NULL
) +
theme_classic() +
theme(
strip.background = element_blank(),
strip.text = element_text(face = "bold")
)
return(list(
gene_id = gene_id,
plot_data = plot_df,
plot = p
))
}
p
