library(ComplexHeatmap)
library(circlize)
library(dplyr)
library(tibble)
library(paletteer)
setwd("~/Projects/Jairaj/CG6277_lipase/")
## KEGG pathways to generate figures
kegg_to_plot <- read.table("data/metadata/KEGG_pathway_metadata/KEGG_pathway_IDs_heatmaps.txt", header = FALSE, sep = "\t")
colnames(kegg_to_plot) <- c("pathway_ID", "description")
# ============================================================
# Example expected inputs
# ============================================================
# de:
#
#       gene       padj    log2FC
# 1     TP53      0.001      2.3
# 2     CDKN1A    0.004      1.7
# ...
de <- read.table("results/transcriptomics/DGE/results_Body_M_vs_WT_Ad_libitum_prot_coding.txt", header = TRUE, sep = "\t")
# expr:
#
#          CTRL_1 CTRL_2 MUT_1 MUT_2
# TP53        4.2    4.7   7.1   6.8
# CDKN1A      2.1    2.0   5.4   5.7
# ...
#expr <- read.table("results/transcriptomics/DGE/results_Body_M_vs_WT_Ad_libitum_prot_coding.xlsx", header = TRUE, sep = "\t")
expr <- read.table("results/transcriptomics/DGE/log2CPM_Body_M_vs_WT_Ad_libitum_02_09_2026.txt", header = TRUE, sep = "\t")
#rownames(expr) <- expr$gene_id
# sample_info:
#
#   sample   condition
#   CTRL_1   Control
#   CTRL_2   Control
#   MUT_1    Mutant
#   MUT_2    Mutant
sample_info <- read.table("data/metadata/transcriptomics/metadata_RNA_Seq.txt", header = TRUE, sep = "\t")
#subsetting to get only WT and Mutant for body ad libitum
sample_info <- sample_info[sample_info$Genotype %in% c("WT", "Mutant"),]
sample_info <- sample_info[sample_info$Organ %in% c("Body"),]
sample_info <- sample_info[sample_info$Feeding %in% c("Ad_libitum"),]
sample_info$sample <- sample_info$SampleID
# 1. Select the DE genes
# Modify the thresholds as appropriate.
de_sig <- de %>%
filter(
!is.na(adj.P.Val),
adj.P.Val < 0.2,
abs(logFC) >= 0
)
# 2. Convert gene symbols to Entrez IDs
# KEGG genes are represented using Entrez IDs.
symbol_to_entrez <- AnnotationDbi::select(
org.Dm.eg.db,
keys = unique(de_sig$gene_name),
keytype = "SYMBOL",
columns = "ENTREZID"
) %>%
filter(!is.na(ENTREZID)) %>%
distinct(SYMBOL, ENTREZID)
gene_map <- AnnotationDbi::select(
org.Dm.eg.db,
keys = rownames(expr),
keytype = "FLYBASE",
columns = c("SYMBOL", "GENENAME", "ALIAS", "SYMBOL")
)
#gene_annot <- read.table("data/metadata/fbgn_annotation_ID_fb_2026_02.tsv", header = TRUE, sep = "\t", comment.char = "", quote = "")
gene_annot <- read.table("data/metadata/gene_information/fbgn_annotation_ID_fb_2026_02.tsv", header = TRUE, sep = "\t", comment.char = "", quote = "")
#3. Download the current KEGG pathway membership
kegg_organism <- "dme"
gene_to_pathway <- KEGGREST::keggLink(
"pathway",
kegg_organism
)
head(gene_to_pathway)
#The result has gene IDs as names and pathway IDs as values. Convert it to a table:
kegg_membership <- tibble(
kegg_gene = names(gene_to_pathway),
pathway_id = unname(gene_to_pathway)
) %>%
mutate(
ENTREZID = sub("^dme:Dmel_", "", kegg_gene),
pathway_id = sub("^path:", "", pathway_id)
)
# Get pathway names:
pathway_names <- KEGGREST::keggList(
"pathway",
kegg_organism
)
pathway_names <- tibble(
pathway_id = sub("^path:", "", names(pathway_names)),
pathway_name = unname(pathway_names)
) %>%
mutate(
pathway_name = sub(" - Drosophila melanogaster \\(fruit fly\\)$", "", pathway_name)
)
# This uses KEGG's organism-specific pathway listings through keggList().
# 4. Assign your DE genes to KEGG pathways
de_kegg <- de_sig %>%
inner_join(
symbol_to_entrez,
by = c("gene_name" = "SYMBOL")
) %>%
inner_join(
kegg_membership %>%
select(ENTREZID, pathway_id),
by = c("gene_name" = "ENTREZID")
) %>%
inner_join(
pathway_names,
by = "pathway_id"
) %>%
distinct(gene_name, pathway_id, pathway_name, .keep_all = TRUE)
