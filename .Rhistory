keys = rownames(expr),
keytype = "FLYBASE",
columns = c("SYMBOL", "GENENAME", "ALIAS", "SYMBOL")
)
#gene_annot <- read.table("data/metadata/fbgn_annotation_ID_fb_2026_02.tsv", header = TRUE, sep = "\t", comment.char = "", quote = "")
gene_annot <- read.table("data/metadata/gene_information/fbgn_annotation_ID_fb_2026_02.tsv", header = TRUE, sep = "\t", comment.char = "", quote = "")
#3. Download the current KEGG pathway membership
kegg_organism <- "dme"
gene_to_pathway <- KEGGREST::keggLink(
"pathway",
kegg_organism
)
head(gene_to_pathway)
#The result has gene IDs as names and pathway IDs as values. Convert it to a table:
kegg_membership <- tibble(
kegg_gene = names(gene_to_pathway),
pathway_id = unname(gene_to_pathway)
) %>%
