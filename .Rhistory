# ============================================================
# 2. Input objects
# ============================================================
metabolite_metadata <- read.table(file = "data/metabolomics_heatmap/metabolite_metadata.tsv",
sep = "\t",
quote = "",
header = TRUE,
comment.char = "")
sample_metadata <- read.table(file = "data/metabolomics_heatmap/sample_metadata.tsv",
sep = "\t",
quote = "",
header = TRUE,
comment.char = "")
dim(sample_metadata)
sample_metadata
groups_to_keep <- c("MUT_LIP_FED_BODY",
"WT_LIP_FED_BODY")
sample_metadata <- sample_metadata[sample_metadata$GROUP2 %in% groups_to_keep,]
sample_metadata
log_data <- read.table(
"data/metabolomics_heatmap/log2_metabolite_expression.tsv",
header = TRUE,
sep = "\t",
check.names = FALSE,
quote = "",
stringsAsFactors = FALSE
)
rownames(log_data) <- log_data$PARENT_SAMPLE_NAME
log_data$PARENT_SAMPLE_NAME <- NULL
log_mat <- as.matrix(log_data)
storage.mode(log_mat) <- "numeric"
stats <- read.table(file = "data/metabolomics_heatmap/statistics.tsv",
sep = "\t",
quote = "",
header = TRUE,
comment.char = "")
# Because KEGG and HMDB may be stored either as plain identifiers or hyperlinks, these functions extract the actual IDs.
extract_kegg_id <- function(x) {
x <- as.character(x)
stringr::str_extract(
x,
"C\\d{5}"
)
}
extract_hmdb_id <- function(x) {
x <- as.character(x)
stringr::str_extract(
x,
"HMDB\\d+"
)
}
extract_pubchem_id <- function(x) {
x <- as.character(x)
# Extract integer-like PubChem identifier
out <- stringr::str_extract(
x,
"\\d+"
)
out[out == ""] <- NA_character_
out
}
# ============================================================
# 4. Clean the metabolite metadata
# ============================================================
# Creates standardized matching identifiers while retaining CHEM_ID as the primary internal identifier.
metabolite_metadata_clean <- metabolite_metadata %>%
mutate(
CHEM_ID = as.character(CHEM_ID),
KEGG_ID = extract_kegg_id(KEGG),
HMDB_ID = extract_hmdb_id(HMDB),
PUBCHEM_ID = extract_pubchem_id(PUBCHEM),
PLOT_LABEL = case_when(
!is.na(PLOT_NAME) &
PLOT_NAME != "" ~ as.character(PLOT_NAME),
!is.na(CHEMICAL_NAME) &
CHEMICAL_NAME != "" ~ as.character(CHEMICAL_NAME),
TRUE ~ CHEM_ID
)
)
# Check the result:
metabolite_metadata_clean %>%
select(
CHEM_ID,
PLOT_LABEL,
KEGG_ID,
HMDB_ID,
PUBCHEM_ID,
SUPER_PATHWAY,
SUB_PATHWAY
) %>%
head()
# ============================================================
# 5. Clean the statistics table
# ============================================================
stats_clean <- stats %>%
mutate(
stats_row = row_number(),
KEGG_ID = extract_kegg_id(KEGG),
HMDB_ID = extract_hmdb_id(HMDB),
PUBCHEM_ID = extract_pubchem_id(PUBCHEM),
log2FC = as.numeric(log2FC),
p_value = as.numeric(`p_value`),
q_value = as.numeric(`q_value`)
)
# ============================================================
# 6. Map the statistics table back to CHEM_ID
# ============================================================
# Mapping hierarchy
# KEGG
# ↓
# HMDB
# ↓
# PubChem
kegg_lookup <- metabolite_metadata_clean %>%
filter(!is.na(KEGG_ID)) %>%
select(
KEGG_ID,
CHEM_ID_KEGG = CHEM_ID
) %>%
distinct()
hmdb_lookup <- metabolite_metadata_clean %>%
filter(!is.na(HMDB_ID)) %>%
select(
HMDB_ID,
CHEM_ID_HMDB = CHEM_ID
) %>%
distinct()
pubchem_lookup <- metabolite_metadata_clean %>%
filter(!is.na(PUBCHEM_ID)) %>%
select(
PUBCHEM_ID,
CHEM_ID_PUBCHEM = CHEM_ID
) %>%
distinct()
# Join all three
stats_mapped <- stats_clean %>%
left_join(
kegg_lookup,
by = "KEGG_ID"
) %>%
left_join(
hmdb_lookup,
by = "HMDB_ID"
) %>%
left_join(
pubchem_lookup,
by = "PUBCHEM_ID"
) %>%
mutate(
# Preferred hierarchy
CHEM_ID = coalesce(
CHEM_ID_KEGG,
CHEM_ID_HMDB,
CHEM_ID_PUBCHEM
),
match_method = case_when(
!is.na(CHEM_ID_KEGG) ~ "KEGG",
!is.na(CHEM_ID_HMDB) ~ "HMDB",
!is.na(CHEM_ID_PUBCHEM) ~ "PubChem",
TRUE ~ NA_character_
)
)
# ============================================================
# 7. Check for identifier conflicts
# ============================================================
# We do not want KEGG to identify one metabolite while HMDB identifies another without noticing.
stats_mapped <- stats_mapped %>%
rowwise() %>%
mutate(
n_distinct_mappings = n_distinct(
c(
CHEM_ID_KEGG,
CHEM_ID_HMDB,
CHEM_ID_PUBCHEM
),
na.rm = TRUE
),
mapping_conflict = n_distinct_mappings > 1
) %>%
ungroup()
# Inspect any conflicts
stats_mapped %>%
filter(mapping_conflict) %>%
select(
stats_row,
KEGG_ID,
HMDB_ID,
PUBCHEM_ID,
CHEM_ID_KEGG,
CHEM_ID_HMDB,
CHEM_ID_PUBCHEM
)
# Inspect unmatched metabolites:
stats_mapped %>%
filter(is.na(CHEM_ID)) %>%
select(
KEGG_ID,
HMDB_ID,
PUBCHEM_ID,
log2FC,
q_value
)
